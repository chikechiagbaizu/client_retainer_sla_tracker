<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="rule_account_manager" model="ir.rule">
            <field name="name">accont.manager.rule</field>
            <field name="model_id" ref="model_client_retainer" />
            <field name="domain_force">[('account_manager_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_account_manager'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
    </data>
</odoo>